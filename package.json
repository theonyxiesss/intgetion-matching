{
  "name": "@intgetion/matching",
  "version": "0.1.0",
  "description": "Matching for INTGETION JOB LIST: candidate-job scoring with explanations, the match feed, dismissals and the recalculation queue.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/modules/matching/service/index.ts",
    "./score": "./src/modules/matching/score/index.ts",
    "./ports": "./src/ports.ts",
    "./server": "./src/server/app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "start": "tsx src/server/main.ts",
    "migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@intgetion/kit": "github:theonyxiesss/intgetion-kit#v0.3.1",
    "drizzle-orm": "^0.45.3",
    "pino": "10.4.0",
    "postgres": "^3.4.9",
    "tsx": "^4.20.0",
    "zod": "^4.6.5",
    "@intgetion/candidates": "github:theonyxiesss/intgetion-candidates#v0.1.1",
    "@intgetion/taxonomy": "github:theonyxiesss/intgetion-taxonomy#v0.3.0",
    "@intgetion/jobs": "github:theonyxiesss/intgetion-jobs#v0.1.1",
    "@intgetion/applications": "github:theonyxiesss/intgetion-applications#v0.1.1",
    "@intgetion/users": "github:theonyxiesss/intgetion-users#v0.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.11.0",
    "pg": "^8.13.0",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
